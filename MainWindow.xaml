<Window x:Class="MockTax.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MockTax" Height="360" Width="520" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24">
    <TextBlock Text="MockTax test application" FontSize="20" Margin="0,0,0,18" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="Recipient" Margin="0,0,8,8" />
      <TextBox Grid.Row="0" Grid.Column="1" x:Name="RecipientName"
               AutomationProperties.AutomationId="RecipientName" Margin="0,0,0,8" />
      <TextBlock Grid.Row="1" Text="Box 2" Margin="0,0,8,8" />
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="Box2"
               AutomationProperties.AutomationId="Box2" Margin="0,0,0,8" />
      <TextBlock Grid.Row="2" Text="Box 14" Margin="0,0,8,8" />
      <TextBox Grid.Row="2" Grid.Column="1" x:Name="Box14"
               AutomationProperties.AutomationId="Box14" Margin="0,0,0,8" />
      <TextBlock Grid.Row="3" Text="Box 22" Margin="0,0,8,8" />
      <TextBox Grid.Row="3" Grid.Column="1" x:Name="Box22"
               AutomationProperties.AutomationId="Box22" Margin="0,0,0,8" />
    </Grid>
    <Button x:Name="SaveButton" Content="Save" AutomationProperties.AutomationId="Save"
            Width="100" HorizontalAlignment="Right" Margin="0,14,0,0" Click="SaveButton_Click" />
    <TextBlock x:Name="Status" Margin="0,14,0,0" Foreground="DarkGreen" />
  </StackPanel>
</Window>
